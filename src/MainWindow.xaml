<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Journey Launcher" Width="1180" Height="790" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0D1118" Foreground="#EEF1F4" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E6EAF0"/><Setter Property="Background" Value="#232D3C"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#121923" BorderBrush="#253040" BorderThickness="0,0,1,0"><Grid Margin="20,27,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="J / JOURNEY" FontSize="20" FontWeight="Bold"/><TextBlock Text="G A M E   L I B R A R Y" Foreground="#8192A8" FontSize="10" Margin="0,9,0,35"/></StackPanel>
   <Border Grid.Row="1" CornerRadius="6" Background="#253244" BorderBrush="#C99B60" BorderThickness="3,0,0,0" Padding="15,16"><StackPanel><TextBlock Text="WARPLEX AE" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="After Earth" Foreground="#A8B5C6" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
   <StackPanel Grid.Row="3"><Button x:Name="SettingsButton" Content="Settings" HorizontalContentAlignment="Left"/><TextBlock Text="JOURNEY LAUNCHER  /  0.2" Foreground="#64758C" FontSize="9" Margin="0,20,0,0"/><TextBlock Text="Windows preview" Foreground="#64758C" FontSize="10" Margin="0,5,0,0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
   <Border BorderBrush="#253040" BorderThickness="0,0,0,1" Padding="30,0"><Grid><TextBlock Text="YOUR GAMES" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/><TextBlock x:Name="AccessLabel" Text="LOCAL PREVIEW" Foreground="#CBA875" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Background="#030506" Padding="28,26,28,20"><StackPanel><Image x:Name="Logo" Height="208" Stretch="Uniform"/><TextBlock Text="TURN-BASED STRATEGY  /  WINDOWS PC" HorizontalAlignment="Center" FontSize="10" Foreground="#9EADBD" Margin="0,10,0,4"/></StackPanel></Border>
    <StackPanel Margin="30,23,30,22"><TextBlock Text="Warplex: After Earth" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Choose your army. Read the terrain. Command the battlefield." Foreground="#A5B2C4" FontSize="13" Margin="0,8,0,22"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Border Background="#161F2B" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="PATCH NOTES" Foreground="#CBA875" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ReleaseTitle" Text="Development preview" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,10"/><TextBlock x:Name="Notes" Text="The current local game includes army building, terrain-based battles, single-player skirmishes, and Map Workshop. This is a development build for testing." Foreground="#A8B5C6" FontSize="12" LineHeight="20"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#161F2B" CornerRadius="6" Padding="20"><StackPanel><TextBlock Text="TESTER DESK" Foreground="#CBA875" FontSize="10" FontWeight="Bold"/><TextBlock Text="Your next deployment" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,10"/><TextBlock Text="Import your tester invitation in Settings to connect to private releases. Your launcher checks for updates when it opens." Foreground="#A8B5C6" FontSize="12" LineHeight="20"/></StackPanel></Border>
     </Grid>
    </StackPanel>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="#121A25" BorderBrush="#2C394A" BorderThickness="0,1,0,0" Padding="30,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock x:Name="StateLabel" Text="Ready to install" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="Status" Text="Choose an installation source in Settings." Foreground="#9BAEC3" FontSize="12" Margin="0,6,0,7"/><ProgressBar x:Name="Progress" Height="5" Maximum="100" Value="0" Foreground="#D0A166" Background="#293647" BorderThickness="0"/><TextBlock x:Name="VersionLabel" Foreground="#73869E" FontSize="10" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><Button x:Name="ActionButton" Content="INSTALL" Background="#C99B60" Foreground="#141A21" FontWeight="Bold" FontSize="16" Padding="20,13"/><Button x:Name="CheckButton" Content="Check for updates" Background="Transparent" Padding="12,8" Margin="0,4,0,0"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</Window>
